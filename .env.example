PORT=4000

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospital_db

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Used to build links in emails (e.g. password reset). Point this at wherever
# the frontend is actually served from.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Email (SMTP) — OPTIONAL. If SMTP_HOST is left blank, the app doesn't fail;
# it just logs what would have been sent to the console instead, so
# everything (invites, password resets) still works end-to-end in dev
# without a real mail provider. Fill these in for real email delivery.
#
# Any standard SMTP provider works — Gmail (with an App Password), SendGrid,
# Mailgun, Postmark, your own mail server, etc.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Wardline <no-reply@wardline.local>"
